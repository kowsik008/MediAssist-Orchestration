# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_MODE=integrated
SERVICE_NAME=governance-service
SERVICE_VERSION=1.0.0
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002
LOG_LEVEL=INFO

# ── CORS origins (Member 4 Next.js + Integration Gateway) ────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ── Integration URLs (other members' services) ────────────────────────────────
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8001
ORCHESTRATION_SERVICE_URL=http://127.0.0.1:8003
INTEGRATION_API_URL=http://127.0.0.1:8000

# ── Guardrails ────────────────────────────────────────────────────────────────
GUARDRAILS_ENABLED=true
GUARDRAILS_DEGRADED_FALLBACK=true
MAX_QUERY_LENGTH=4096
MAX_CONVERSATION_TURNS=20
HIGH_RISK_ESCALATION_ENABLED=true
GROUNDING_PASS_THRESHOLD=0.85
CITATION_VALIDITY_MIN=0.95

# ── Optional Gemini grounding verifier ──────────────────────────────────────
# NEVER commit actual key — set via environment only
GEMINI_GUARDRAIL_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── PostHog (primary analytics) ──────────────────────────────────────────────
POSTHOG_ENABLED=true
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://app.posthog.com
POSTHOG_TIMEOUT_SECONDS=5
POSTHOG_LOCAL_FALLBACK=true

# ── SQLite (fallback analytics + audit) ──────────────────────────────────────
SQLITE_PATH=./storage/audit/meditrust.db
SQLITE_TIMEOUT_SECONDS=10

# ── JSONL (last-resort analytics) ────────────────────────────────────────────
JSONL_FALLBACK_PATH=./storage/analytics/events.jsonl

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_RETAIN_DAYS=90
AUDIT_STORE_RAW_QUERY=false

# ── Regeneration ──────────────────────────────────────────────────────────────
MAX_REGENERATION_ATTEMPTS=1

# ── Metrics ───────────────────────────────────────────────────────────────────
METRICS_WINDOW_HOURS=24

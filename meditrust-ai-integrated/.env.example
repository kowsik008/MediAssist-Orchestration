APP_ENV=development
APP_MODE=integrated
CHROMA_PERSIST_DIRECTORY=./storage/chroma
CHROMA_KNOWLEDGE_COLLECTION=meditrust_knowledge
CHROMA_CACHE_COLLECTION=meditrust_response_cache
SOURCE_MANIFEST_PATH=./data/source_manifest.json
PUBLIC_DATA_DIR=./data/public
SYNTHETIC_DATA_DIR=./data/synthetic
CACHE_TTL_SECONDS=86400
CACHE_SIMILARITY_THRESHOLD=0.88
